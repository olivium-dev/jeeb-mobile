<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Development/profile provisioning only. Release uses
	     Runner.Release.entitlements and production APNs. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Canonical staging edge. Cloudflare must serve the AASA file at
	     /.well-known/apple-app-site-association without redirects. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.jeeb.fds-1.com</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
