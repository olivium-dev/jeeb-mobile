# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
pubspec.lock

# IDE
.idea/
.vscode/
*.iml

# macOS
.DS_Store
*.swp

# Android
android/.gradle/
android/local.properties
android/captures/
android/gradlew
android/gradlew.bat
# Ignore the Gradle build dir contents but allow descent so the wrapper
# properties can be tracked. CI has no committed wrapper, so without this it
# resolves Gradle 8.4 — and AGP 8.11.1 requires Gradle >= 8.13. The wrapper
# jar stays ignored (Flutter/Gradle bootstraps it).
android/gradle/*
!android/gradle/wrapper/
android/gradle/wrapper/*
!android/gradle/wrapper/gradle-wrapper.properties
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# iOS — track the Runner Xcode project (parity with android/); ignore only
# generated / machine-specific / dependency artifacts.
ios/Pods/
ios/.symlinks/
ios/.generated/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Flutter/.last_build_id
# Generated by `flutter build`; machine-specific paths, "do not check in".
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*
ios/**/xcuserdata/
ios/**/DerivedData/

# Coverage
coverage/

# Build / capture junk (not source; keep the integration tree clean)
# Flutter crash logs dropped at repo root by the tool
flutter_*.log
# Ad-hoc capture/QA screenshots dropped at the repo root (numbered PNGs).
# Scoped to root only — assets/**, docs/screenshots/**, android/** PNGs stay tracked.
/*.png
# Figma Dev Mode screenshot cache (regenerated on demand)
docs/figma-cache/
# Kotlin build cache (Gradle/AGP artifact, regenerated per build)
.kotlin/

# Decompiled Maestro APK / JAR artifacts accidentally extracted at the repo root.
# Root-anchored (leading /) so legitimate nested dirs of the same name are unaffected.
# These are NOT source — delete from disk when convenient; never commit them.
/AndroidManifest.xml
/DebugProbesKt.bin
/classes*.dex
/resources.arsc
/report.xml
/maestro_android.proto
/custom.config.*
/META-INF/
/dadb/
/google/
/kotlin/
/maestro/
/maestro_android/
/org/
/samples/

# Firebase Android build input — the real jeeb-5a293 google-services.json is now
# committed (JEBV4-173/JEBV4-223) so fresh clones build staging/production
# without a skip-worktree overlay. google-services.json holds Firebase *client*
# config (public by design), not a private key. iOS + generated options stay
# ignored below; copy the committed *.template or run `flutterfire configure`.
ios/Runner/GoogleService-Info.plist
# FlutterFire-generated real options (placeholder template stays committed).
lib/core/firebase/firebase_options.g.dart

# Agent worktrees (large, machine-local)
.claude/worktrees/
