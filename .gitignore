# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# IDE
.idea/
.vscode/
*.iml

# macOS
.DS_Store
*.swp

# Android
android/.gradle/
android/local.properties
android/captures/
# Ignore other Gradle build-dir contents while tracking the complete,
# checksum-gated wrapper required to bootstrap Gradle 8.14.4 reproducibly.
android/gradle/*
!android/gradle/wrapper/
android/gradle/wrapper/*
!android/gradle/wrapper/gradle-wrapper.properties
!android/gradle/wrapper/gradle-wrapper.jar
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# iOS — track the Runner Xcode project (parity with android/); ignore only
# generated / machine-specific / dependency artifacts.
ios/Pods/
ios/.symlinks/
ios/.generated/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Flutter/.last_build_id
# Generated by `flutter build`; machine-specific paths, "do not check in".
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*
ios/**/xcuserdata/
ios/**/DerivedData/

# Coverage
coverage/

# Build / capture junk (not source; keep the integration tree clean)
# Flutter crash logs dropped at repo root by the tool
flutter_*.log
# Firebase CLI diagnostics can contain local paths, account metadata, and
# request traces. Keep them out of source control and evidence bundles.
/firebase-debug.log
# Ad-hoc capture/QA screenshots dropped at the repo root (numbered PNGs).
# Scoped to root only — assets/**, docs/screenshots/**, android/** PNGs stay tracked.
/*.png
# Figma Dev Mode screenshot cache (regenerated on demand)
docs/figma-cache/
# Kotlin build cache (Gradle/AGP artifact, regenerated per build)
.kotlin/

# Firebase CLI debug logs (emulator suite junk, regenerated on demand)
firebase-debug.log
firestore-debug.log

# Decompiled Maestro APK / JAR artifacts accidentally extracted at the repo root.
# Root-anchored (leading /) so legitimate nested dirs of the same name are unaffected.
# These are NOT source — delete from disk when convenient; never commit them.
/AndroidManifest.xml
/DebugProbesKt.bin
/classes*.dex
/resources.arsc
/report.xml
/maestro_android.proto
/custom.config.*
/META-INF/
/dadb/
/google/
/kotlin/
/maestro/
/maestro_android/
/org/
/samples/

# Firebase native client configs are protected build-time inputs. They identify
# the canonical public Firebase app, but their package/signer bindings still
# belong to the release boundary and are injected through validated wrappers.
# Only placeholder templates are committed; real Android/iOS configs must stay
# absent from source and are removed by the wrapper trap after every build.
android/app/src/dev/google-services.json
/android/app/google-services.json
ios/Runner/GoogleService-Info.plist
# Transient release build setting derived from the protected iOS plist.
ios/Flutter/ProtectedFirebase.xcconfig
# Runner.xcworkspace is the canonical hybrid CocoaPods+SwiftPM graph. Xcode may
# generate this redundant project-local resolution file during local probing.
ios/Runner.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
# FlutterFire-generated real options (placeholder template stays committed).
lib/core/firebase/firebase_options.g.dart

# Android candidate custody private material is environment-secret only. The
# matching public certificate is the sole PEM allowed under .github/release/.
/.github/release/*private*.pem
/.github/release/*.key.pem

# Agent worktrees (large, machine-local)
.claude/worktrees/
