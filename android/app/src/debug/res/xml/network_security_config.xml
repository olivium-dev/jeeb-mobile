<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config.

  Allows cleartext (plain HTTP) traffic to a tightly-scoped allowlist:
    - localhost / 127.0.0.1 / 10.0.2.2 (emulator alias): `adb reverse`-tunnelled
      requests to the live gateway reach the MacBook socat forwarder, and the
      Express mock on :4010.
    - 192.168.2.39 (MSI native backend, S16): the dev-debug acceptance build
      targets the native jeeb-gateway on the LAN host over plain HTTP
      (dart-define GATEWAY_BASE_URL=http://192.168.2.39:10090,
       USE_MOCK_GATEWAY=false). The MSI host serves the raw gateway contract
      (/v1/auth/otp/*, /v1/deliveries, /v1/devices/register, /api/User/*) over
      cleartext on the private network; without this entry every gateway call
      from the emulator would be blocked by the Android 9+ HTTPS-only default
      and surface as a false 'product' connection error.

  This is intentionally scoped to loopback + the single MSI LAN IP only —
  production and staging builds do NOT include this file and therefore keep the
  Android 9+ default (HTTPS-only for every non-listed address).

  Wired into the debug AndroidManifest below via android:networkSecurityConfig.
  Safe to commit: debug-only, scoped to loopback + one private LAN IP, no
  credentials.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">192.168.2.39</domain>
  </domain-config>
</network-security-config>
