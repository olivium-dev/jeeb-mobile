<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) cold-start splash, dark mode.

  The Jeeb brand splash is navy in both light and dark (the Flutter
  BrandedSplash does not invert), so the SplashScreen attributes match
  values-v31/styles.xml. Parent is the Black no-title-bar theme to align with
  the existing values-night LaunchTheme.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/jeeb_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/jeeb_splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
