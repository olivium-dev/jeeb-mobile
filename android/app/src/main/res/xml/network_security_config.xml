<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠️  TEST / DEV-E2E SEAM — applies to the RELEASE (and every non-debug) build.
  ============================================================================
  WHY THIS EXISTS
  The signed production-release APK must be runnable, on a PHYSICAL DEVICE, for a
  full-cycle E2E against the native jeeb-gateway dev backend on the MSI host,
  which serves the raw gateway contract over PLAIN HTTP (no TLS) on :10090.

  The device reaches that backend through a USB/adb reverse tunnel:
      device  http://localhost:10090
        └── adb reverse tcp:10090 tcp:10090  ──▶  Mac :10090
              └── ssh -L 10090:localhost:10090 msi  ──▶  MSI jeeb-gateway :10090
  Android 9+ (targetSdk 34) blocks cleartext HTTP by default, so WITHOUT this
  file the release build refuses http://localhost:10090 and every gateway call
  fails at the network layer before the request is even sent.

  SCOPE — cleartext is permitted ONLY to loopback + the LAN dev host:
    - localhost / 127.0.0.1        adb-reverse tunnel target (the E2E path)
    - 10.0.2.2                     Android-emulator host-loopback alias
    - 192.168.2.39                 MSI native jeeb-gateway on the LAN (direct)
  EVERYTHING ELSE stays HTTPS-only (base-config cleartextTrafficPermitted=false):
  the app still talks HTTPS to the real production gateway (api.jeeb.app) — this
  seam does NOT weaken prod-domain traffic.

  ⚠️  BEFORE A REAL STORE RELEASE: remove this file + the
  android:networkSecurityConfig attribute in src/main/AndroidManifest.xml (or
  move both behind a dev/staging flavor source set) so the shippable production
  APK keeps the strict Android 9+ HTTPS-only default for all hosts.

  Mirrors the already-committed, deliberately-scoped debug seam at
  src/debug/res/xml/network_security_config.xml. No credentials; safe.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">192.168.2.39</domain>
  </domain-config>
</network-security-config>
