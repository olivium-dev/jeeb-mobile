<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 (API 24-30) cold-start splash window background.

  Was: a flat @android:color/white window. With the system centring the navy
  ic_launcher square on top, the splash read as "white screen + navy square".

  Now: full-bleed brand navy with the Jeeb wordmark centred, matching the
  Flutter BrandedSplash (colorScheme.secondaryContainer == #0B1351) so the
  OS-splash -> Flutter-splash hand-off shows one continuous branded screen.
  Android 12+ uses the SplashScreen API instead (values-v31/styles.xml).

  Note: the centred item references the vector wordmark directly (a layer-list
  <item> accepts a VectorDrawable; <bitmap> would not). width/height pin the
  wordmark to a compact 168x68 box so it is centred, not stretched.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/jeeb_navy" />
    <item
        android:width="168dp"
        android:height="68dp"
        android:gravity="center"
        android:drawable="@drawable/jeeb_splash_logo" />
</layer-list>
