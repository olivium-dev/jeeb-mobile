<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        T-mobile-032: Push notifications.
        - POST_NOTIFICATIONS is required on Android 13+; the actual prompt
          is triggered from Dart via FirebaseMessaging.requestPermission().
        - WAKE_LOCK + RECEIVE_BOOT_COMPLETED come from firebase_messaging
          and are listed here so the merge gives the lint a stable picture.
        - The default channel id ("jeeb_default") must match
          `jeebDefaultChannel.id` in firebase_messaging_transport.dart so
          notifications sent by jeeb-gateway with `android_channel_id` route
          to the channel we register at runtime.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!--
        T-MOB-011: Voice-request recorder.
        - RECORD_AUDIO is the runtime (dangerous) permission required to capture
          microphone audio via the `record` package. The actual prompt is
          triggered from Dart on first record via AudioRecorder.hasPermission()
          (RecordVoiceRecorder.start); denial is mapped to
          VoiceRecorderFailure.permissionDenied and surfaced as an OMDS message.
        - MODIFY_AUDIO_SETTINGS is requested by the AAC encoder on some OEM
          Android builds to configure the capture session; harmless if unused.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!--
        Sprint 1 Stream B (T-MOB-017): live-tracking map + device location.
        - ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION back the geolocator GPS
          fix that feeds the courier puck. The runtime prompt is triggered from
          Dart via Geolocator.requestPermission() behind the location port;
          denial degrades to the gateway-supplied last-known position.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
                Tapping an FCM notification dispatches this intent so the OS
                routes it to MainActivity; the Dart side resolves the deep
                link from the payload via deepLinkForMessage().
            -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!--
                Sprint 1 Stream B: custom-scheme deep links (jeeb://…) used by
                push payloads + share links to route into the app
                (flutter_deep_linking / go_router resolves the path).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="jeeb"/>
            </intent-filter>
        </activity>

        <!--
            Default channel id for FCM. Lets the FCM SDK display
            notifications even before the Dart side has created the channel
            (cold push before bootstrap completes).
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jeeb_default"/>

        <!--
            Sprint 1 Stream B (T-MOB-017): Google Maps SDK API key. The value
            is injected at build time from the ${MAPS_API_KEY} manifest
            placeholder (android/app/build.gradle ← -PMAPS_API_KEY / gradle.
            properties / CI secret). NEVER hardcode a real key here.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>

        <!--
            Explicit FCM service registration. firebase_messaging merges its
            own service via manifest-merger, but declaring it here keeps the
            merged picture stable for lint and documents the contract.
        -->
        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>
