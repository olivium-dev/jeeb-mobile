<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        T-mobile-032: Push notifications.
        - POST_NOTIFICATIONS is required on Android 13+; the actual prompt
          is triggered from Dart via FirebaseMessaging.requestPermission().
        - WAKE_LOCK + RECEIVE_BOOT_COMPLETED come from firebase_messaging
          and are listed here so the merge gives the lint a stable picture.
        - The default channel id ("jeeb_default") must match
          `jeebDefaultChannel.id` in firebase_messaging_transport.dart so
          notifications sent by jeeb-gateway with `android_channel_id` route
          to the channel we register at runtime.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        Reconnect self-heal: the `connectivity_plus` plugin observes
        ConnectivityManager to report offline->online transitions, which
        `NetworkReachabilitySignals` turns into the app-wide reconnect signal
        (core/network/). ACCESS_NETWORK_STATE is merged in from the plugin's own
        manifest; it is listed here for the same reason WAKE_LOCK and
        RECEIVE_BOOT_COMPLETED are — so the merge gives the lint a stable
        picture and the app's real permission set is readable in one file.
        It is a NORMAL (non-dangerous) permission: granted at install, no
        runtime prompt, and nothing to request from Dart.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
        JEBV4-213 (E18): biometric unlock via the `local_auth` plugin.
        - USE_BIOMETRIC is the modern (API 28+) permission for BiometricPrompt;
          USE_FINGERPRINT is its pre-28 predecessor, kept for older devices.
          Neither is a runtime (dangerous) permission, so no prompt is shown; the
          BiometricPrompt/device-credential dialog is driven from Dart via
          LocalAuthBiometricGateway.authenticate(). The Activity must also be a
          FlutterFragmentActivity (see MainActivity.kt).
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!--
        T-MOB-011: Voice-request recorder.
        - RECORD_AUDIO is the runtime (dangerous) permission required to capture
          microphone audio via the `record` package. The actual prompt is
          triggered from Dart on first record via AudioRecorder.hasPermission()
          (RecordVoiceRecorder.start); denial is mapped to
          VoiceRecorderFailure.permissionDenied and surfaced as an OMDS message.
        - MODIFY_AUDIO_SETTINGS is requested by the AAC encoder on some OEM
          Android builds to configure the capture session; harmless if unused.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!--
        JEBV4-176: device-GPS for the "Current Location" pickup option.
        - ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION are required by the
          `geolocator` plugin; WITHOUT them geolocator throws
          PermissionDefinitionsNotFoundException at checkPermission(), so every
          getCurrentPosition() call fails before the OS can even show the
          runtime permission dialog — collapsing the whole GPS-recovery flow to
          the "failed" card on every launch. Declaring them here is what lets
          geolocator's checkPermission()/requestPermission() surface the real
          OS dialog and resolve a genuine fix. The runtime prompt itself is
          triggered from Dart (CurrentLocationResolver → geolocator); denial is
          mapped to the honest permission-denied recovery card (no Beirut
          fallback), and services-off maps to the services-off card.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!--
        P0 (MB1 / live tracking): the JEEBER's GPS uploader.
        - ACCESS_BACKGROUND_LOCATION is what makes `always` REACHABLE at all on
          Android 10+ (API 29). Without this line, geolocator's
          `PermissionManager.checkPermissionStatus` short-circuits:
            geolocator_android-5.0.3 PermissionManager.java:71-76
              boolean wantsBackgroundLocation =
                  PermissionUtils.hasPermissionInManifest(
                      context, Manifest.permission.ACCESS_BACKGROUND_LOCATION);
              if (!wantsBackgroundLocation) return LocationPermission.whileInUse;
          and `requestPermission` never even ADDS the background permission to
          the request array (:104-111). So `Geolocator.checkPermission()` and
          `Geolocator.requestPermission()` could only ever return `whileInUse`,
          `BackgroundGpsCubit.start()` (which demands `always`) parked in
          `permissionDenied` on EVERY delivery, and the customer's live-tracking
          map never received a single fix — `POST /location/update` was never
          called even once. `adb shell pm grant … ACCESS_BACKGROUND_LOCATION`
          exits 0 and does NOTHING while the app does not declare it, which is
          why the failure survived months of manual testing.
        - It is a RUNTIME (dangerous) permission and Android 10+ REFUSES to
          grant it in the same prompt as the foreground permissions. The
          escalation is driven from Dart, incrementally, by
          `BackgroundGpsCubit.start()`: foreground first
          (`requestWhileInUsePermission`), then a SEPARATE background request
          (`requestAlwaysPermission`). On Android 11+ the user must pick
          "Allow all the time" on the app's location settings page, so a
          non-`always` result is NOT treated as fatal — it parks the uploader in
          `BackgroundGpsPhase.permissionDenied`, emits a `bg_gps_phase`
          `[jeeb-diag]` breadcrumb, and raises the OMDS permission banner on the
          Active Delivery screen with an "Open settings" CTA
          (`GpsPermissionBanner`).
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!--
        P1 (2026-08-01): the "separate change" the block above deferred. It is
        no longer separable — a courier who backgrounds the app stops feeding
        the customer's map, which is the same P1 as one who navigates away.

        Holding `always` is necessary but NOT sufficient. A plain
        `getPositionStream` is owned by the activity, so once the app leaves the
        foreground Android's background-location throttling (API 26+) cuts
        delivery to a couple of fixes an HOUR. The pipeline stays in
        `phase:"tracking"` throughout — it looks healthy and reports nothing.

        `AndroidSettings.foregroundNotificationConfig` (see
        `GeolocatorGeocaptureGateway.defaultSettings`) makes geolocator run its
        own `GeolocatorLocationService` in the foreground. That service is
        already declared by the plugin with
        `android:foregroundServiceType="location"`
        (geolocator_android-5.0.3 AndroidManifest.xml), and it is merged into
        this app — but the plugin declares NO permissions, so the two below are
        ours to add:
          - FOREGROUND_SERVICE: required to call startForeground() at all
            (API 28+).
          - FOREGROUND_SERVICE_LOCATION: required ADDITIONALLY from API 34, and
            this app targets 36 (`android/app/build.gradle`: targetSdk 36).
            Without it `startForeground()` with a `location` type throws
            SecurityException at runtime, so the uploader would die the instant
            it went to background — the exact failure being fixed.
        These are no longer dead permissions: the config that activates the
        service ships in the same change.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
                Tapping an FCM notification dispatches this intent so the OS
                routes it to MainActivity; the Dart side resolves the deep
                link from the payload via deepLinkForMessage().
            -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!--
                S007-P1B: in-app deep links into the go_router tree so the
                accepted-order chat is reachable WITHOUT tapping a push.
                Flutter's built-in deep linking (flutter_deeplinking_enabled
                below) hands the VIEW intent's URI to go_router, which matches
                on the PATH.
                  * Custom scheme `jeeb://chat/<conversationId>` — no domain
                    verification needed (host == "chat"); AppRouter normalises
                    the host-form to the canonical `/chat/:id` route.
                  * HTTPS App Link `https://${APP_LINK_HOST}/chat/<conversationId>` —
                    path is already `/chat/<id>` so go_router matches directly.
                    The release flavors use app.jeeb.fds-1.com; dev retains the
                    historical jeeb.app host. Requires assetlinks.json (infra).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="${APP_LINK_HOST}"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="jeeb"/>
            </intent-filter>
        </activity>

        <!--
            Jeeber Dev Tool second launcher icon. This activity-alias reuses the
            SAME MainActivity (same process, DI, session, storage — full access),
            but launching via this icon makes MainActivity.getInitialRoute()
            return "/devtool", so lib/main.dart boots the Dev Tool shell instead
            of the product app. Gated by @bool/jeeb_devtool_enabled (resValue in
            build.gradle: true on dev/staging, false on production), so the icon
            only appears on non-production builds — defence-in-depth alongside
            the compile-time kDevToolEnabled dart-define.
        -->
        <!-- F5: image_cropper (uCrop) needs its host activity registered;
             portrait-locked to match F4's app-wide lock. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>

        <activity-alias
            android:name=".DevToolLauncher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="@bool/jeeb_devtool_enabled"
            android:label="Jeeber Dev Tool"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!--
            S007-P1B: enable Flutter's built-in deep linking so the VIEW
            intents above are delivered to go_router (the initial route on a
            cold start, and pushRouteInformation while running). Orthogonal to
            FCM, which is handled in Dart via firebase_messaging callbacks.
        -->
        <meta-data
            android:name="flutter_deeplinking_enabled"
            android:value="true"/>

        <!--
            Default channel id for FCM. Lets the FCM SDK display
            notifications even before the Dart side has created the channel
            (cold push before bootstrap completes).
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jeeb_default"/>

        <!--
            sprint-013: Google Maps SDK for Android API key. Injected from the
            gitignored android/local.properties via the ${MAPS_API_KEY}
            manifestPlaceholder (build.gradle defaultConfig) — the key itself is
            never committed. The provisioned key is restricted to package
            com.olivium.jeeb + the release SHA1 and to Maps SDK for Android +
            Places API. Presence of com.google.android.geo.API_KEY here is what
            the tracking_map_placeholder_route_test gate allows before the live
            map (LiveTrackingScreen.useLiveMap) may be flipped back on.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>

    <!-- F2: package visibility (API 30+) for the WhatsApp CTA; w4b = WhatsApp
         Business. wa.me needs none, but canLaunchUrl/whatsapp:// would fail. -->
    <queries>
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
    </queries>
</manifest>
