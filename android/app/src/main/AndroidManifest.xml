<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        T-mobile-032: Push notifications.
        - POST_NOTIFICATIONS is required on Android 13+; the actual prompt
          is triggered from Dart via FirebaseMessaging.requestPermission().
        - WAKE_LOCK + RECEIVE_BOOT_COMPLETED come from firebase_messaging
          and are listed here so the merge gives the lint a stable picture.
        - The default channel id ("jeeb_default") must match
          `jeebDefaultChannel.id` in firebase_messaging_transport.dart so
          notifications sent by jeeb-gateway with `android_channel_id` route
          to the channel we register at runtime.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!--
        T-MOB-011: Voice-request recorder.
        - RECORD_AUDIO is the runtime (dangerous) permission required to capture
          microphone audio via the `record` package. The actual prompt is
          triggered from Dart on first record via AudioRecorder.hasPermission()
          (RecordVoiceRecorder.start); denial is mapped to
          VoiceRecorderFailure.permissionDenied and surfaced as an OMDS message.
        - MODIFY_AUDIO_SETTINGS is requested by the AAC encoder on some OEM
          Android builds to configure the capture session; harmless if unused.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!--
        T-MOB-012 / T-MOB-017: Maps + GPS.
        - ACCESS_FINE_LOCATION is the precise-location runtime (dangerous)
          permission `geolocator` requests via Geolocator.requestPermission()
          (GeolocatorGeocaptureGateway.requestAlwaysPermission). It backs the
          "centre on my location" button on the drop-off picker and the
          courier-position fix.
        - ACCESS_COARSE_LOCATION is the city-block-accuracy fallback Android
          may grant instead of FINE on the 12+ two-button prompt; geolocator
          downgrades gracefully when only COARSE is held.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
                Tapping an FCM notification dispatches this intent so the OS
                routes it to MainActivity; the Dart side resolves the deep
                link from the payload via deepLinkForMessage().
            -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!--
            Default channel id for FCM. Lets the FCM SDK display
            notifications even before the Dart side has created the channel
            (cold push before bootstrap completes).
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jeeb_default"/>

        <!--
            T-MOB-012 / T-MOB-017: Google Maps Android API key.
            The literal key is NEVER committed. `${MAPS_API_KEY}` is a manifest
            placeholder injected at build time by android/app/build.gradle from
            (in priority order) the gradle property `MAPS_API_KEY`, the env var
            `MAPS_API_KEY`, or local.properties `MAPS_API_KEY`. When none is
            supplied the placeholder resolves to the documented sentinel
            "YOUR_MAPS_API_KEY_HERE" so the manifest still merges and the rest
            of the app builds/runs — only the GoogleMap tiles render grey with a
            "for development purposes only" watermark until the owner drops the
            real key in. See MAPS-IMPL.md "Where the owner injects the key".
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>
