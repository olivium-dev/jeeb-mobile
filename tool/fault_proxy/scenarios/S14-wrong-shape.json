{
  "scenario": "S14",
  "rules": [
    {
      "id": "wrong-shape",
      "match": {
        "method": "GET",
        "path": "^/gateway/(v1/)?users/me(\\?.*)?$"
      },
      "times": 0,
      "respond": {
        "status": 200,
        "headers": {
          "Content-Type": "text/html"
        },
        "body": "<html>captive portal</html>"
      }
    }
  ],
  "expect": {
    "kind": "unknown",
    "copyTitle": "errorGenericTitle",
    "copyBody": "errorGenericBody",
    "retryable": true
  },
  "device": {
    "screen": "profile",
    "mode": "cold",
    "expectedHits": 1,
    "requiredIds": [
      "customer_profile_load_error",
      "customer_profile_retry_cta"
    ],
    "forbiddenPlaceholders": [
      "Add your name",
      "No reviews yet",
      "?"
    ],
    "notes": "Clear faults and verify recovery after each scenario."
  },
  "variants": [
    {
      "name": "json-list",
      "respond": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "[]"
      }
    }
  ]
}
