{
  "scenario": "S02",
  "rules": [
    {
      "id": "unavailable-503",
      "match": {
        "method": "GET",
        "path": "^/gateway/(v1/)?users/me(\\?.*)?$"
      },
      "times": 0,
      "respond": {
        "status": 503,
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "body": "{\"type\":\"https://httpstatuses.com/503\",\"title\":\"Service Unavailable\",\"status\":503}"
      }
    }
  ],
  "expect": {
    "kind": "server",
    "copyTitle": "errorServerTitle",
    "copyBody": "errorServiceUnavailableBody",
    "retryable": true,
    "unavailable": true
  },
  "device": {
    "screen": "profile",
    "mode": "cold",
    "expectedHits": 3,
    "requiredIds": [
      "customer_profile_load_error",
      "customer_profile_retry_cta"
    ],
    "forbiddenPlaceholders": [
      "Add your name",
      "No reviews yet",
      "?"
    ],
    "notes": "Clear faults and verify recovery after each scenario."
  }
}
