{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/jeeb/**",
              "ui_kits/jeeb-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Baloo Bhaijaan 2))/i]",
        "message": "Font not provided by the design system. Available: Inter, Baloo Bhaijaan 2."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|soft|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, soft, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|orange|success|muted|flash|express|standard|ontheway|eco)$/]",
        "message": "<Badge> tone must be one of 'navy' | 'orange' | 'success' | 'muted' | 'flash' | 'express' | 'standard' | 'ontheway' | 'eco'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|full|leadingIcon|trailingIcon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, full, leadingIcon, trailingIcon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|selected|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, selected, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|outlined|muted|filled)$/]",
        "message": "<Card> variant must be one of 'plain' | 'outlined' | 'muted' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSend|onMic|onAttach|placeholder|key|ref|className|style|children)$/]",
        "message": "<ChatInput> doesn't accept that prop. Declared props: value, onChange, onSend, onMic, onAttach, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|size|filled|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, tone, size, filled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|ghost|light|surface)$/]",
        "message": "<IconButton> tone must be one of 'navy' | 'ghost' | 'light' | 'surface'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|leadingIcon|trailingIcon|onTrailingClick|multiline|rows|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, placeholder, leadingIcon, trailingIcon, onTrailingClick, multiline, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|time|read|children|key|ref|className|style|children)$/]",
        "message": "<MessageBubble> doesn't accept that prop. Declared props: from, time, read, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:me|them)$/]",
        "message": "<MessageBubble> from must be one of 'me' | 'them'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OfferCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|rating|message|time|accepted|onAccept|key|ref|className|style|children)$/]",
        "message": "<OfferCard> doesn't accept that prop. Declared props: name, rating, message, time, accepted, onAccept."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressTracker'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|tone|key|ref|className|style|children)$/]",
        "message": "<ProgressTracker> doesn't accept that prop. Declared props: steps, current, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressTracker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|white)$/]",
        "message": "<ProgressTracker> tone must be one of 'navy' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingStars'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|showValue|key|ref|className|style|children)$/]",
        "message": "<RatingStars> doesn't accept that prop. Declared props: value, max, size, showValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierMeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|emoji|color|promise|framing|key|ref|className|style|children)$/]",
        "message": "<TierMeta> doesn't accept that prop. Declared props: name, emoji, color, promise, framing."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|selected|onSelect|key|ref|className|style|children)$/]",
        "message": "<TierOption> doesn't accept that prop. Declared props: tier, selected, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopAppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|logoSrc|action|onAction|onLogo|key|ref|className|style|children)$/]",
        "message": "<TopAppBar> doesn't accept that prop. Declared props: title, logoSrc, action, onAction, onLogo."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
